# Credentials for nomads-agent.
#
# These are an alternative to `nomads auth key`, useful when you would rather
# not write the key to disk. Environment variables take precedence over the
# stored session. Copy to .env and fill in; .env is gitignored.

# Your Nomads.com handle, without the leading @.
NOMADS_USERNAME=yourhandle

# Personal API key from https://nomads.com/settings.
# Enables reading and adding trips through the official API.
NOMADS_API_KEY=

# Optional: override the config directory (default ~/.config/nomads-agent).
# NOMADS_AGENT_HOME=

# Note: editing or deleting trips, and every profile operation, need a browser
# session instead, because the official API has no endpoint for them:
#   nomads auth login --link "<magic link from your email>"
